# Gemini / Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_API_KEY=your-gemini-api-key

# Google Cloud
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# YouTube Data API v3
YOUTUBE_API_KEY=your-youtube-data-api-v3-key

# Google OAuth2 (for Workspace function tools — Calendar, Tasks, Gmail, Docs, Drive)
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-pre-authorized-oauth-refresh-token

# MCP Toolbox (database tools)
MCP_TOOLBOX_URL=http://localhost:5000

# Cloud SQL — PostgreSQL 15 (URL-encode @ in password as %40)
# Instance: eduflow-db (asia-southeast1). Get public IP from:
#   gcloud sql instances describe eduflow-db --format="value(ipAddresses[0].ipAddress)"
DB_HOST=your-cloudsql-public-ip
DB_USER=your-db-user
DB_PASSWORD=your-db-password
SESSION_DB_URI=postgresql+asyncpg://your-db-user:your-db-password@your-cloudsql-public-ip/eduflow

# Frontend → Backend (used by streamlit_app.py)
BACKEND_URL=http://localhost:8000
