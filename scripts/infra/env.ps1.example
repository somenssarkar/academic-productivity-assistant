# env.ps1.example — Copy to env.ps1, fill in values, run before starting backend
# Usage: . .\scripts\infra\env.ps1

$env:GOOGLE_GENAI_USE_VERTEXAI    = "0"
$env:GOOGLE_API_KEY               = "your-gemini-api-key"
$env:YOUTUBE_API_KEY              = "your-youtube-data-api-v3-key"
$env:GOOGLE_CLOUD_PROJECT         = "your-gcp-project-id"
$env:GOOGLE_CLOUD_LOCATION        = "us-central1"
$env:GOOGLE_OAUTH_CLIENT_ID       = "your-oauth-client-id"
$env:GOOGLE_OAUTH_CLIENT_SECRET   = "your-oauth-client-secret"
$env:GOOGLE_OAUTH_REFRESH_TOKEN   = "your-pre-authorized-oauth-refresh-token"
$env:MCP_TOOLBOX_URL              = "http://localhost:5000"
$env:SESSION_DB_URI               = "postgresql+asyncpg://user:password@localhost:5432/eduflow"
$env:DB_USER                      = "postgres"
$env:DB_PASSWORD                  = "your-db-password"
$env:BACKEND_URL                  = "http://localhost:8000"

Write-Host "EduFlow environment variables loaded."
